{
  "name": "verify-semantic-changelog-update",
  "version": "0.0.0",
  "description": "Ensure your PR contains a changelog entry for all the user facing changes.",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"**/*.ts\"",
    "format-check": "prettier --check \"**/*.ts\"",
    "lint": "eslint src __tests__",
    "package": "ncc build lib/main.js --source-map --license licenses.txt",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GetStream/verify-semantic-changelog-update.git"
  },
  "keywords": [
    "actions",
    "github-action",
    "conventional-commits",
    "semantic",
    "changelog"
  ],
  "author": "GetStream",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/GetStream/verify-semantic-changelog-update/issues"
  },
  "homepage": "https://github.com/GetStream/verify-semantic-changelog-update",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "conventional-commit-types": "^3.0.0",
    "conventional-commits-parser": "^7.1.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.14.0",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jest": "^29.17.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
